# Copy to .env and fill in. Never commit .env.

# The shop's folder: shop.json, products.csv, faq.md. "demo" is a made-up fabric shop.
SHOP_DIR=demo
DB_PATH=salesdesk.db
TIMEZONE=Europe/London

# claude: use for every real shop.
# gemini: free-tier testing only (Google may use free-tier prompts), never with real customers' messages.
# rules: no API key, keyword answers only. For offline demos and tests.
PROVIDER=claude
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Meta Model API (dev.meta.ai). PROVIDER=muse uses Muse Spark as the brain. The key also turns on voice notes
# (Muse Voice Transcribe, needs ffmpeg), receipt reading (a screenshot is never proof of payment).
META_API_KEY=
META_MODEL=muse-spark-1.3

# Web server.
HOST=127.0.0.1
PORT=8792
# Online demo: every screen and /api/ call only opens with ?k=<DEMO_KEY>. Leave empty on this laptop.
DEMO_KEY=
# The demo phone, forged-payment buttons and reset. Turn off for a real shop.
DEMO_TOOLS=true
# Secret for /inbound/email and /inbound/tiktok (?token=...).
INBOUND_TOKEN=

# WhatsApp Cloud API. Webhook: {your https address}/webhook/whatsapp, subscribe to "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# An approved template with one body variable, for follow-ups after the 24-hour window.
WHATSAPP_TEMPLATE=

# Instagram DMs (Instagram API with Instagram Login). Webhook: {your https address}/webhook/instagram.
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Email replies. Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram: a bot customers can chat to (demos), and the owner's group for alerts and the morning brief.
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=


# Behaviour.
HISTORY_MESSAGES=12
DAILY_CAP=600
SUMMARY_HOUR=8
KEEP_DAYS=365

# PayPal. Leave the first two empty to use the built-in MOCK PayPal (offline demo and tests).
# Sandbox: developer.paypal.com > Apps & Credentials > Sandbox > Create App (type Merchant, not Platform).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# The Webhook ID shown after you add https://<your address>/paypal/webhook on the app's page.
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_ENV=sandbox
# Where PayPal and the buyer's browser reach this server (the tunnel or Render address, no slash at the end).
PUBLIC_URL=
