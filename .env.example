# Copy to .env and fill in. Never commit .env.

# The shop's folder: shop.json, products.csv, faq.md. "demo" is a made-up fabric shop.
SHOP_DIR=demo
DB_PATH=salesdesk.db
TIMEZONE=Africa/Lagos

# claude: use for every real shop.
# gemini: free-tier testing only (Google may use free-tier prompts), never with real customers' messages.
# rules: no API key, keyword answers only. For offline demos and tests.
PROVIDER=claude
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Meta Model API (dev.meta.ai). PROVIDER=muse uses Muse Spark as the brain. The key also turns on voice notes
# (Muse Voice Transcribe, needs ffmpeg), receipt reading, ad advice and ad picture drafts (Muse Image).
META_API_KEY=
META_MODEL=muse-spark-1.3
# Meta ads (read-only). A token with ads_read and the ad account id. Without them the brief shows demo/ads.json as a sample.
META_ADS_TOKEN=
META_AD_ACCOUNT=

# Web server.
HOST=127.0.0.1
PORT=8792
# Online demo: every screen and /api/ call only opens with ?k=<DEMO_KEY>. Leave empty on this laptop.
DEMO_KEY=
# The demo phone, test bank alerts and reset. Turn off for a real shop.
DEMO_TOOLS=true
# Secret for /inbound/email, /inbound/bank-alert and /inbound/tiktok (?token=...).
INBOUND_TOKEN=

# WhatsApp Cloud API. Webhook: {your https address}/webhook/whatsapp, subscribe to "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# An approved template with one body variable, for follow-ups after the 24-hour window.
WHATSAPP_TEMPLATE=

# Instagram DMs (Instagram API with Instagram Login). Webhook: {your https address}/webhook/instagram.
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Email replies. Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram: a bot customers can chat to (demos), and the owner's group for alerts and the morning brief.
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Bank alerts. The robot reads credit-alert emails (read-only) and matches them to orders.
# Gmail: IMAP_HOST=imap.gmail.com, IMAP_USER=you@gmail.com, IMAP_PASSWORD=an app password (not your password).
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# The domain(s) your bank sends alerts from. Check one real alert email's From address and put exactly that here.
BANK_ALERT_SENDERS=
# Confirm by itself only when an alert is signed by the bank and matches exactly one order. false = always ask.
AUTO_CONFIRM=true
CHECK_ALERTS_MINUTES=2

# Behaviour.
HISTORY_MESSAGES=12
DAILY_CAP=600
SUMMARY_HOUR=8
KEEP_DAYS=365
